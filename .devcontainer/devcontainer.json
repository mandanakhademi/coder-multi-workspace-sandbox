{
  "name": "Coder Single Workspace Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "workspace",
  "workspaceFolder": "/workspace",
  
  // Exposes both application ports to the host network automatically
  "forwardPorts": [3000, 8000],
  
  // Adds human-readable labels to the ports inside the Coder interface
  "portsAttributes": {
    "3000": {
      "label": "Frontend App UI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Backend Python API",
      "onAutoForward": "silent"
    }
  },

  // Useful IDE extensions that will auto-install for whoever opens the workspace
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
