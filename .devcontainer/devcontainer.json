{
  "name": "Coder Multi-Container Sandbox",
  // === CORRECTION: Look locally since both files are in the same directory ===
  "dockerComposeFile": "docker-compose.yml",
  
  "service": "frontend", 
  "workspaceFolder": "/workspace",
  
  "remoteUser": "root",
  "containerUser": "root",
  "updateRemoteUserUID": "never",

  "forwardPorts":,
  "portsAttributes": {
    "3000": { "label": "Frontend App UI", "onAutoForward": "notify" },
    "8000": { "label": "Backend Python API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
