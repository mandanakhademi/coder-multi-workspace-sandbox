{
  "name": "Coder Single Workspace Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  
  // Change this from "workspace" to one of your actual compose services!
  "service": "frontend", 
  
  "workspaceFolder": "/workspace",
  "forwardPorts": [3000, 8000],
  
  "portsAttributes": {
    "3000": {
      "label": "Frontend App UI",
      "onAutoForward": "notify"
    },
    "8000": {
      "label": "Backend Python API",
      "onAutoForward": "silent"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
