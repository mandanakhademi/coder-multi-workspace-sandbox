{
  "name": "Coder Multi-Container Sandbox",
  "dockerComposeFile": "docker-compose.yml",
  "service": "frontend", 
  "workspaceFolder": "/workspace",
  
  // === FIX: Add this line to skip the dynamic ARM64 vs AMD64 docker build step ===
  "updateRemoteUserUID": "never",

  "forwardPorts":,
  "portsAttributes": {
    "3000": { "label": "Frontend App UI", "onAutoForward": "notify" },
    "8000": { "label": "Backend Python API", "onAutoForward": "silent" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "dbaeumer.vscode-eslint"
      ]
    }
  }
}
